# Loaded from the working directory. Exported variables take precedence.
APP_SERVER_HOST=0.0.0.0
APP_SERVER_PORT=8080
APP_SERVER_MAX_BODY_BYTES=1048576
APP_SERVER_READ_HEADER_TIMEOUT=5s
APP_SERVER_READ_TIMEOUT=30s
APP_SERVER_WRITE_TIMEOUT=30s
APP_SERVER_IDLE_TIMEOUT=60s
APP_SERVER_SHUTDOWN_TIMEOUT=30s
# Empty disables CORS. Separate explicit allowed origins with commas.
APP_SERVER_CORS_ALLOWED_ORIGINS=

APP_LOGGER_LEVEL=info
APP_LOGGER_FORMAT=json

APP_APP_NAME=golang-server-template
APP_APP_VERSION=1.0.0
APP_APP_ENVIRONMENT=development
